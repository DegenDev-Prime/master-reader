# `eslint-config-expo` pulls in `eslint-import-resolver-typescript`, which
# depends on `unrs-resolver`. Its optional wasm binding declares
# `@emnapi/core` and `@emnapi/runtime` as optional peers, and npm resolves
# those to a newer version than the lock file records. `npm ci` then refuses
# to install on a machine with a cold cache.
#
# Resolving peers the same way for `npm install` and `npm ci` keeps the
# installed tree identical to the lock file.
legacy-peer-deps=true
