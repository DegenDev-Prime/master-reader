{
  "expo": {
    "name": "Master Reader",
    "slug": "master-reader",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "master-reader",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.masterreader",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#101014",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionName": "0.2.0"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101014",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-localization",
      "expo-background-task",
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class app.masterreader.sherpatts.** { *; }\n-keep class com.k2fsa.sherpa.onnx.** { *; }\n-keep class ai.onnxruntime.** { *; }"
          }
        }
      ],
      "./plugins/with-abi-splits",
      "./plugins/with-gradle-heap",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
